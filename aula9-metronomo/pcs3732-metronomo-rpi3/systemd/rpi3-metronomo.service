[Unit]
Description=Metrônomo PWM para Raspberry Pi 3
After=network.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/rpi3-metronomo
ExecStart=/usr/bin/python3 /opt/rpi3-metronomo/src/metronome.py --bpm 60
Restart=on-failure
RestartSec=2
Nice=-5
# Para SCHED_FIFO, configure LimitRTPRIO e use --rt-priority com cautela.
LimitRTPRIO=20
RuntimeDirectory=rpi3-metronomo
StateDirectory=rpi3-metronomo
LogsDirectory=rpi3-metronomo

[Install]
WantedBy=multi-user.target
